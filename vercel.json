{
  "version": 2,
  "builds": [
    {
      "src": "python_api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "150mb"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/py-api/(.*)",
      "destination": "/python_api/index.py"
    }
  ]
}